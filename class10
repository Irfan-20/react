// index.css

*{
  margin: 0px;
  padding: 0px;
  box-sizing: 0px;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background-color: #f9f9f9;
  padding: 40px 20px;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 20px;
  max-width: 1200px;
  margin: 0 auto;
}

@media (min-width: 640px) {
  .grid-container {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (min-width: 1024px) {
  .grid-container {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

.box {
  background: white;
  border: 1px solid #e0e0e0;
  box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
}

.box-image {
  width: 100%;
  height: 180px;
  object-fit: cover;
}

.box-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.box h3 {
  margin: 0 0 12px 0;
  font-size: 1.25rem;
  color: #111;
}

#para {
  margin: 0 0 20px 0;
  font-size: 0.9rem;
  color: #555;
  line-height: 1.5;
  flex-grow: 1;
}

.box button {
  width: 100%;
  background-color: #7f7f7f;
  color: white;
  border: none;
  padding: 10px;
  cursor: pointer;
  font-weight: bold;
  font-size: 0.85rem;
}

.box button:hover {
  background-color: #666666;
}
